# ---------------------------------------------------------------------------
# PAPER-ONLY CONFIGURATION. This project has no live-trading mode.
# Any variable/URL that looks live makes startup fail (see PAPER_TRADING_SAFETY.md).
# All values below are safe placeholders. Copy to .env and edit.
# ---------------------------------------------------------------------------
TRADING_MODE=paper

# Data provider: "fixture" (offline deterministic replay) or "alpaca" (market DATA only)
DATA_PROVIDER=fixture

# Database. SQLite for development; a PostgreSQL URL is supported by the schema
# e.g. postgresql+psycopg://user:pass@localhost:5432/scanalert  (driver not bundled)
DATABASE_URL=sqlite:///./data/scanalert.db

# Server
HOST=127.0.0.1
PORT=8000

# Universe (comma separated) used by the fixture provider and as the default scan universe
UNIVERSE=ORBX,GAPU,TRND,FLAT,WIDE,SPKE,DRFT,LOWV

# Fixture replay: 0 = as fast as possible, 1 = real time, 60 = 60x
FIXTURE_REPLAY_SPEED=0
FIXTURE_SEED=42
# true = start the replay automatically when the server starts
FIXTURE_AUTOSTART=true

# Alpaca MARKET DATA credentials (data only; never order/trading keys).
# Leave blank unless DATA_PROVIDER=alpaca.
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET_KEY=
ALPACA_DATA_FEED=iex
ALPACA_DATA_WS_URL=wss://stream.data.alpaca.markets/v2
ALPACA_DATA_REST_URL=https://data.alpaca.markets

# Sessions
ENABLE_PREMARKET=false
ENABLE_POSTMARKET=false

# Scanner / freshness
STALE_FEED_SECONDS=15
DELAYED_DELIVERY_MS=2000
TOP_LIST_REFRESH_SECONDS=30
TOP_LIST_MAX_ROWS=100

# Pipeline tuning
EVAL_MIN_INTERVAL_MS=250
QUEUE_MAXSIZE=10000
PERSIST_RAW_EVENTS=true

# Optional non-transactional notification channels (disabled by default)
EMAIL_ENABLED=false
WEBHOOK_ENABLED=false
WEBHOOK_URL=
